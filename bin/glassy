#!/usr/bin/env bash
# ==================================================================
#  glassy - Verwaltung fuer claudes-glassy
#
#    glassy --update      neuesten STABILEN Stand holen (Branch main) und installieren
#    glassy --debug       TEST-Stand holen (Branch debug) und installieren
#    glassy --status      welcher Stand ist installiert? Updates da?
#    glassy --upgrade     Update fuer deinen aktuellen Kanal (main oder debug) installieren
#    glassy --check       nach Updates suchen (--notify: als Benachrichtigung, --force: auch "alles aktuell")
#    glassy --whatsnew    was ist neu / was hat sich geaendert
#    glassy --watch       im Hintergrund regelmaessig suchen (startet mit Hyprland)
#    glassy --doctor      pruefen      (glassy --repair: kaputte Dateien reparieren)
#    glassy --restore     altes Backup zurueckspielen
#    glassy --settings    Einstellungen oeffnen (wie SUPER+I)
#    glassy --reload      Shell (Quickshell) und Hyprland neu laden
#    glassy --theme       Themes anzeigen   (glassy --theme catppuccin: Theme setzen,
#                         glassy --theme material: Farben aus dem Wallpaper)
#    glassy --miku-wall   neues Hatsune-Miku-Wallpaper in deiner Aufloesung (--startup: nur wenn eingeschaltet)
#    glassy --miku-res    Aufloesung fuer Miku-Wallpaper (glassy --miku-res 1920x1080, ohne Wert: auto)
#    glassy --miku-start  Miku-Wallpaper bei jedem Start an/aus
#    glassy --idle [on|off]  automatisch sperren + Bildschirm aus (hypridle) an/aus
#    glassy --perf        Performance-Modus an/aus (weniger Blur/Schatten)
#    glassy --logs        Log der Shell (Quickshell) anzeigen
#    glassy --fix-venv    Python-Umgebung neu bauen (wenn Material You nicht geht)
#    glassy --deploy      (Vitra) Paket in dein ~/.config uebernehmen (macht vtx sonst von selbst)
#    glassy --help        diese Hilfe
#
#  Ablauf bei Fehlern: Fixes kommen zuerst auf "debug" -> mit "glassy --debug"
#  testen -> wenn alles passt, landet es auf "main" -> "glassy --update".
#
#  Vitra: kommt glassy als Paket (glassy-shell aus [vitra]), holt "glassy --update"
#  das Paket ueber vtx/pacman. "glassy --debug" geht weiter direkt von GitHub.
# ==================================================================
set -uo pipefail

REPO_URL="https://github.com/femboyss/claudes-glassy"
DEST="$HOME/.local/share/claudes-glassy"
GIT_DEST="$DEST"   # Repo-Kopie fuer --debug (auch wenn glassy als Paket kommt)
CHANNEL_FILE="$HOME/.local/state/claudes-glassy/channel"

c_ok()   { printf '\033[38;2;158;206;106m[ok]\033[0m %s\n' "$*"; }
c_info() { printf '\033[38;2;122;162;247m[..]\033[0m %s\n' "$*"; }
c_warn() { printf '\033[38;2;224;175;104m[!!]\033[0m %s\n' "$*"; }
c_err()  { printf '\033[38;2;247;118;142m[xx]\033[0m %s\n' "$*"; }

# Vitra-Paket (glassy-shell): Dateien liegen in /usr/share/glassy
PKG_HOME="/usr/share/glassy"
PKG_NAME="glassy-shell"
is_package() { [ -f "$PKG_HOME/install.sh" ] && pacman -Q "$PKG_NAME" >/dev/null 2>&1; }

channel() {
    local c; c="$(cat "$CHANNEL_FILE" 2>/dev/null)"
    if [ -z "$c" ]; then is_package && c=package || c=main; fi
    echo "$c"
}
# im Paket-Modus (nicht auf debug) kommen alle Dateien aus dem Paket
if [ "$(channel)" = package ] && is_package; then DEST="$PKG_HOME"; fi

set_channel() { mkdir -p "$(dirname "$CHANNEL_FILE")"; echo "$1" > "$CHANNEL_FILE"; }

package_update() {   # glassy-shell ueber vtx (oder pacman) aktualisieren
    set_channel package
    if command -v vtx >/dev/null 2>&1; then
        vtx -S "$PKG_NAME" && vtx deploy "$PKG_NAME"
    else
        sudo pacman -S "$PKG_NAME" && bash "$PKG_HOME/install.sh" --deploy fix
    fi
}

deploy_now() {   # $1 = install | upgrade | fix
    is_package || { c_err "glassy-shell ist nicht als Paket installiert (vtx -S glassy-shell)"; return 1; }
    bash "$PKG_HOME/install.sh" --deploy "${1:-fix}"
}

fetch_branch() {   # $1 = main | debug
    local b="$1"
    DEST="$GIT_DEST"
    command -v git >/dev/null 2>&1 || sudo pacman -S --needed git
    if [ ! -d "$DEST/.git" ]; then
        rm -rf "$DEST"
        git clone --depth 1 --branch "$b" "$REPO_URL" "$DEST" || { c_err "Klonen fehlgeschlagen"; exit 1; }
    else
        if [ -n "$(git -C "$DEST" status --porcelain 2>/dev/null)" ]; then
            local bak="$HOME/.local/share/claudes-glassy-lokal-$(date +%Y%m%d-%H%M%S).patch"
            git -C "$DEST" diff > "$bak" 2>/dev/null || true
            c_warn "Lokale Aenderungen in der Repo-Kopie gesichert: $bak"
        fi
        c_info "Hole Branch '$b' von GitHub ..."
        git -C "$DEST" fetch --depth 1 origin "$b" || { c_err "Branch '$b' nicht gefunden / kein Netz"; exit 1; }
        git -C "$DEST" checkout -q -B "$b" FETCH_HEAD
        git -C "$DEST" reset -q --hard FETCH_HEAD
        git -C "$DEST" clean -fdq
    fi
    mkdir -p "$(dirname "$CHANNEL_FILE")"
    echo "$b" > "$CHANNEL_FILE"
    c_ok "Stand: $b  $(git -C "$DEST" log -1 --format='%h  %s')"
}

install_now() {
    bash "$DEST/install.sh" --auto
}

status() {
    local b local_rev remote_rev
    b="$(channel)"
    if [ "$b" = package ]; then
        echo "Kanal:      package   (Vitra-Paket aus [vitra])"
        echo "Installiert: $(pacman -Q "$PKG_NAME" 2>/dev/null)"
        echo "Updates:     vtx   (oder: glassy --update)"
        echo "Test-Stand:  glassy --debug   (zurueck zum Paket: glassy --update)"
        return 0
    fi
    echo "Kanal:      $b   ($( [ "$b" = debug ] && echo 'Test-Stand' || echo 'stabil'))"
    if [ -d "$DEST/.git" ]; then
        local_rev="$(git -C "$DEST" rev-parse --short HEAD 2>/dev/null)"
        echo "Installiert: $local_rev  $(git -C "$DEST" log -1 --format='%s  (%cd)' --date=format:'%d.%m.%Y %H:%M')"
        for x in main debug; do
            remote_rev="$(timeout 8 git ls-remote "$REPO_URL" "refs/heads/$x" 2>/dev/null | cut -c1-7)"
            if [ -z "$remote_rev" ]; then
                echo "GitHub $x:  (nicht erreichbar)"
            elif [ "$remote_rev" = "$local_rev" ]; then
                echo "GitHub $x:  $remote_rev  = installiert"
            else
                echo "GitHub $x:  $remote_rev  -> neuer Stand verfuegbar ($( [ "$x" = main ] && echo 'glassy --update' || echo 'glassy --debug'))"
            fi
        done
    else
        c_warn "Noch nicht installiert:  glassy --update"
    fi
}

# ------------------------------------------------------------------ Updates
STATE_DIR="$HOME/.local/state/claudes-glassy"
SHELL_CONFIG="$HOME/.config/illogical-impulse/config.json"
THEME_PY="$HOME/.config/quickshell/ii/scripts/colors/glassy_theme.py"
GLASSY_BIN="$HOME/.local/bin/glassy"

setting() {   # $1 = Schluessel unter .glassy in der Shell-Config, $2 = Standardwert
    local v
    v="$(jq -r --arg k "$1" '.glassy[$k] // empty' "$SHELL_CONFIG" 2>/dev/null)"
    [ -n "$v" ] && echo "$v" || echo "$2"
}

term_run() {  # Befehl in einem Terminal-Fenster ausfuehren (bleibt offen bis Enter)
    setsid -f kitty -1 bash -c "$1; echo; read -r -p 'Enter zum Schliessen '" </dev/null >/dev/null 2>&1
}

remote_rev() { timeout 10 git ls-remote "$REPO_URL" "refs/heads/$1" 2>/dev/null | cut -c1-40; }

# Neue Commits zwischen installiert und GitHub, eine Zeile pro Commit: "hash  Titel"
new_commits() {   # $1 = Branch
    local local_rev
    local_rev="$(git -C "$DEST" rev-parse HEAD 2>/dev/null)"
    git -C "$DEST" fetch -q --depth 60 origin "$1" 2>/dev/null || return 1
    git -C "$DEST" log --format='%H %h  %s' FETCH_HEAD 2>/dev/null | while read -r full rest; do
        [ "$full" = "$local_rev" ] && break
        echo "$rest"
    done
}

notify_update() {   # $1 = Branch, $2 = Anzahl, $3 = Text
    command -v notify-send >/dev/null 2>&1 || return
    local label; label="$( [ "$1" = debug ] && echo 'Test-Stand (debug)' || echo 'stabil (main)')"
    (
        act="$(notify-send -a claudes-glassy -i system-software-update -t 0 \
            -A install="Jetzt installieren" -A news="Was ist neu" -A later="Spaeter" --wait \
            "claudes-glassy: $2 neue Aenderung(en)" "Kanal: $label\n$3")"
        case "$act" in
            install) term_run "$GLASSY_BIN --upgrade" ;;
            news)    term_run "$GLASSY_BIN --whatsnew" ;;
        esac
    ) &
}

check_updates() {   # [--notify] [--force]
    local notify=0 force=0 b local_rev rr list n
    for a in "$@"; do
        case "$a" in --notify) notify=1 ;; --force) force=1 ;; esac
    done
    b="$(channel)"
    # Paket-Modus: Updates kommen ueber vtx/pacman, nicht von GitHub
    [ "$b" = package ] && { c_ok "Updates kommen ueber vtx (Paket $PKG_NAME)"; return 1; }
    [ -d "$DEST/.git" ] || { c_warn "Noch nicht installiert:  glassy --update"; return 2; }
    local_rev="$(git -C "$DEST" rev-parse HEAD 2>/dev/null)"
    rr="$(remote_rev "$b")"
    if [ -z "$rr" ]; then
        c_warn "GitHub nicht erreichbar"
        [ "$notify" = 1 ] && [ "$force" = 1 ] && notify-send -a claudes-glassy "claudes-glassy" "GitHub nicht erreichbar - spaeter nochmal"
        return 2
    fi
    if [ "$rr" = "$local_rev" ]; then
        c_ok "Alles aktuell ($b, ${local_rev:0:7})"
        [ "$notify" = 1 ] && [ "$force" = 1 ] && notify-send -a claudes-glassy -i emblem-default "claudes-glassy" "Alles aktuell (${local_rev:0:7}, Kanal $b)"
        return 1
    fi
    list="$(new_commits "$b")"
    n="$(printf '%s\n' "$list" | grep -c . )"
    [ "$n" -eq 0 ] && { n=1; list="${rr:0:7}  (neuer Stand)"; }
    c_info "$n neue Aenderung(en) auf '$b':"
    printf '%s\n' "$list" | sed 's/^/   /'
    echo "   Installieren:  glassy --upgrade"
    if [ "$notify" = 1 ]; then
        mkdir -p "$STATE_DIR"
        # dieselbe Version nur einmal am Tag melden (ausser "Jetzt suchen")
        local last; last="$(cat "$STATE_DIR/notified" 2>/dev/null)"
        if [ "$force" = 1 ] || [ "$last" != "$rr $(date +%F)" ]; then
            echo "$rr $(date +%F)" > "$STATE_DIR/notified"
            notify_update "$b" "$n" "$(printf '%s\n' "$list" | head -n 4 | cut -c1-70)"
        fi
    fi
    return 0
}

whatsnew() {
    local b list
    b="$(channel)"
    echo "Kanal: $b    Installiert: $(git -C "$DEST" log -1 --format='%h  %s' 2>/dev/null)"
    echo
    list="$(new_commits "$b")"
    if [ -n "$list" ]; then
        c_info "Neu auf GitHub (noch nicht installiert):"
        printf '%s\n' "$list" | sed 's/^/   /'
        echo
        echo "Installieren:  glassy --upgrade"
    else
        c_ok "Du hast den neuesten Stand. Die letzten Aenderungen:"
        git -C "$DEST" fetch -q --depth 15 origin "$b" 2>/dev/null
        git -C "$DEST" log -10 --format='   %h  %s  (%cd)' --date=format:'%d.%m. %H:%M' FETCH_HEAD 2>/dev/null \
            || git -C "$DEST" log -10 --format='   %h  %s' 2>/dev/null
    fi
}

# Automatisch im Hintergrund aktualisieren (ohne Fragen, ohne sudo)
background_update() {
    local b before after missing=()
    mkdir -p "$STATE_DIR"
    b="$(channel)"
    before="$(git -C "$DEST" rev-parse --short HEAD 2>/dev/null)"
    fetch_branch "$b" >/dev/null 2>&1 || { notify-send -a claudes-glassy "claudes-glassy" "Automatisches Update fehlgeschlagen (kein Netz?)"; return 1; }
    bash "$DEST/install.sh" --background >"$STATE_DIR/last-update.log" 2>&1
    after="$(git -C "$DEST" rev-parse --short HEAD 2>/dev/null)"
    # Pakete, die neu dazugekommen sind, brauchen sudo -> nur Bescheid geben
    for p in $(sed -n '/^EXTRA_PKGS=(/,/^)/p' "$DEST/install.sh" | sed '1d;$d' | sed 's/#.*//'); do
        pacman -Q "$p" >/dev/null 2>&1 || missing+=("$p")
    done
    command -v qs >/dev/null 2>&1 || missing+=("quickshell")
    (
        if [ ${#missing[@]} -gt 0 ]; then
            act="$(notify-send -a claudes-glassy -i system-software-update -t 0 -A pkgs="Im Terminal installieren" --wait \
                "claudes-glassy aktualisiert ($before -> $after)" "Neue Pakete noetig: ${missing[*]}")"
            [ "$act" = pkgs ] && term_run "bash $DEST/install.sh --install"
        else
            act="$(notify-send -a claudes-glassy -i emblem-default -A news="Was ist neu" --wait \
                "claudes-glassy aktualisiert" "$before -> $after  ($(git -C "$DEST" log -1 --format='%s' | cut -c1-60))")"
            [ "$act" = news ] && term_run "$GLASSY_BIN --whatsnew"
        fi
    ) &
}

watch_loop() {
    mkdir -p "$STATE_DIR"
    exec 9>"$STATE_DIR/watch.lock"
    flock -n 9 || exit 0                       # laeuft schon
    local waited=0 interval first=1
    sleep 90                                   # nach dem Login erst mal Ruhe
    while true; do
        interval="$(setting update_interval 360)"
        if [ "$first" = 1 ] || { [ "$interval" -gt 0 ] && [ "$waited" -ge $(( interval * 60 )) ]; }; then
            first=0; waited=0
            if [ "$(setting update_check true)" = true ]; then
                if [ "$(setting update_auto false)" = true ]; then
                    check_updates >/dev/null 2>&1 && background_update
                elif [ "$(setting update_notify true)" = true ]; then
                    check_updates --notify >/dev/null 2>&1
                fi
            fi
        fi
        sleep 60; waited=$(( waited + 60 ))
    done
}

reload_all() {
    pkill -x qs 2>/dev/null; pkill -x quickshell 2>/dev/null
    sleep 0.3
    hyprctl reload >/dev/null 2>&1
    setsid -f qs -c ii </dev/null >/dev/null 2>&1
    idle_start
    pgrep -f "glassy --watch" >/dev/null || setsid -f "$GLASSY_BIN" --watch </dev/null >/dev/null 2>&1
    c_ok "neu geladen (Shell + Hyprland)"
}

fix_venv() {   # Python-Umgebung fuer Material You / Farb-Erzeugung neu bauen
    local venv="${XDG_STATE_HOME:-$HOME/.local/state}/quickshell/.venv"
    command -v uv >/dev/null 2>&1 || sudo pacman -S --needed uv
    c_info "Baue Python-Umgebung neu: $venv"
    rm -rf "$venv"
    UV_NO_MODIFY_PATH=1 uv venv --prompt .venv "$venv" -p 3.12 || { c_err "uv venv fehlgeschlagen"; return 1; }
    uv pip install --python "$venv/bin/python" -r "$DEST/deps/uv/requirements.txt" || { c_err "Pakete fehlgeschlagen (Ausgabe oben)"; return 1; }
    "$venv/bin/python" -c "import materialyoucolor, PIL" && c_ok "Python-Umgebung ok - Material You geht jetzt (glassy --theme material)"
}

MIKU_SH="$HOME/.config/quickshell/ii/scripts/colors/random/random_miku_wall.sh"

set_glassy() {   # $1 = Schluessel, $2 = JSON-Wert
    local tmp; tmp="$(mktemp)"
    jq --arg k "$1" --argjson v "$2" '.glassy[$k] = $v' "$SHELL_CONFIG" > "$tmp" && mv "$tmp" "$SHELL_CONFIG"
}

miku_res() {
    local r="${1:-auto}"
    if [ "$r" != auto ] && ! [[ "$r" =~ ^[0-9]+x[0-9]+$ ]]; then
        c_err "Format: BREITExHOEHE, z.B. 1920x1080 (oder auto)"; return 1
    fi
    set_glassy mikuResolution "\"$r\""
    c_ok "Miku-Wallpaper-Aufloesung: $r"
}

miku_start() {
    local now new
    now="$(jq -r '.glassy.mikuWallpaperOnStart // false' "$SHELL_CONFIG" 2>/dev/null)"
    [ "$now" = true ] && new=false || new=true
    set_glassy mikuWallpaperOnStart "$new"
    c_ok "Neues Miku-Wallpaper bei jedem Start: $( [ "$new" = true ] && echo an || echo aus)"
}

# hypridle (nach 10 min sperren, nach 12 min Bildschirme aus) nur wenn glassy.autoIdle an ist
idle_enabled() {
    [ "$(jq -r '.glassy.autoIdle // true' "$SHELL_CONFIG" 2>/dev/null)" != false ]
}

idle_start() {
    if idle_enabled; then
        pgrep -x hypridle >/dev/null || setsid -f hypridle </dev/null >/dev/null 2>&1
    else
        pkill -x hypridle 2>/dev/null || true
    fi
}

idle_set() {
    local want="${1:-}"
    if [ -z "$want" ]; then idle_enabled && want=off || want=on; fi
    case "$want" in
        on)  set_glassy autoIdle true ;;
        off) set_glassy autoIdle false ;;
        *)   c_err "glassy --idle on|off"; return 1 ;;
    esac
    idle_start
    if [ "$want" = on ]; then
        c_ok "Automatisch sperren (10 min) + Bildschirm aus (12 min): an"
    else
        c_ok "Automatisch sperren / Bildschirm aus: aus - der PC bleibt an, bis du selbst sperrst (SUPER+L)"
    fi
}

toggle_perf() {
    local now new
    now="$(jq -r '.glassy.performanceMode // false' "$SHELL_CONFIG" 2>/dev/null)"
    [ "$now" = true ] && new=false || new=true
    local tmp; tmp="$(mktemp)"
    jq ".glassy.performanceMode = $new" "$SHELL_CONFIG" > "$tmp" && mv "$tmp" "$SHELL_CONFIG"
    python3 "$THEME_PY" sync
    c_ok "Performance-Modus: $( [ "$new" = true ] && echo an || echo aus)"
}

case "${1:---help}" in
    --update|-u|update)   if is_package; then package_update
                          else fetch_branch main && install_now; fi ;;
    --debug|-d|debug)     fetch_branch debug && install_now ;;
    --status|-s|status)   status ;;
    --doctor|doctor)      bash "$DEST/doctor.sh" ;;
    --repair|repair)      bash "$DEST/doctor.sh" --repair ;;
    --restore|restore)    bash "$DEST/install.sh" --restore ;;
    --settings|settings)  setsid -f env XDG_CURRENT_DESKTOP=gnome qs -p "$HOME/.config/quickshell/ii/settings.qml" </dev/null >/dev/null 2>&1 ;;
    --reload|reload)      reload_all ;;
    --theme|theme)        shift
                          if [ $# -eq 0 ]; then python3 "$THEME_PY" list
                          else python3 "$THEME_PY" apply "$1"; fi ;;
    --perf|perf)          toggle_perf ;;
    --idle|idle)          shift; idle_set "${1:-}" ;;
    --idle-start)         idle_start ;;
    --miku-wall|miku-wall) shift; bash "$MIKU_SH" "$@" ;;
    --miku-res|miku-res)  shift; miku_res "${1:-auto}" ;;
    --miku-start|miku-start) miku_start ;;
    --fix-venv|fix-venv)  fix_venv ;;
    --logs|logs)          qs -c ii log 2>/dev/null | tail -n 80 || c_warn "Kein Log (laeuft die Shell?)" ;;
    --upgrade|upgrade)    if [ "$(channel)" = package ]; then package_update
                          else fetch_branch "$(channel)" && install_now; fi ;;
    --deploy|deploy)      shift; deploy_now "${1:-fix}" ;;
    --background-update)  background_update ;;
    --check|check)        shift; check_updates "$@" ;;
    --whatsnew|whatsnew)  whatsnew ;;
    --watch|watch)        watch_loop ;;
    --help|-h|help|*)     sed -n '3,29p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
