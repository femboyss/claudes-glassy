{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "positionX": "right",
    "positionY": "top",
    "layer": "overlay",
    "control-center-layer": "top",
    "layer-shell": true,
    "cssPriority": "user",
    "control-center-margin-top": 8,
    "control-center-margin-bottom": 14,
    "control-center-margin-right": 14,
    "control-center-width": 420,
    "notification-window-width": 400,
    "notification-icon-size": 48,
    "notification-body-image-height": 140,
    "notification-body-image-width": 260,
    "timeout": 6,
    "timeout-low": 3,
    "timeout-critical": 0,
    "fit-to-screen": true,
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 200,
    "hide-on-clear": false,
    "hide-on-action": true,
    "widgets": ["title", "dnd", "mpris", "volume", "notifications"],
    "widget-config": {
        "title": {
            "text": "Benachrichtigungen",
            "clear-all-button": true,
            "button-text": "Alle weg"
        },
        "dnd": {
            "text": "Nicht stoeren"
        },
        "mpris": {
            "image-size": 64,
            "image-radius": 14
        },
        "volume": {
            "label": "Lautstaerke"
        }
    }
}
